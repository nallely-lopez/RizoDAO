# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Rust build artifacts (Cargo)
target/
**/target/

# Cargo lock files inside contract subdirectories (library crates don't pin deps)
contracts/**/Cargo.lock

# Soroban test snapshots generated by soroban-sdk testutils
contracts/**/test_snapshots/

# Cargo home cache that may appear inside contract dirs
contracts/**/.cargo/
